# Existing application configuration
SECRET_KEY=replace-with-a-long-random-production-secret
DATABASE_URL=
APP_ENV=production
APP_TIMEZONE=Asia/Kolkata

# External Clinic AI Assistant API (safe staged default)
AI_API_ENABLED=false
AI_ACCESS_TOKEN_TTL_SECONDS=900
AI_AUTH_RATE_LIMIT_PER_MINUTE=20

# Keep false unless the deployment's trusted reverse proxy overwrites and
# sanitizes X-Forwarded-For. Direct clients must not control this header.
AI_API_TRUST_PROXY_HEADERS=false

# Use a separate high-entropy value in production. It fingerprints request IPs
# for security auditing without storing raw IP addresses.
AI_AUDIT_FINGERPRINT_SECRET=

# Later functional phases will use these flags independently.
AI_OTP_ENABLED=false
AI_SECURE_REPORT_DELIVERY_ENABLED=false
AI_CALLBACKS_ENABLED=false
AI_COMPLAINTS_ENABLED=false
AI_NOTIFICATIONS_ENABLED=false

# OmniDimension Custom API gateway. This is a separate, narrow integration
# surface for public clinic information and staff-reviewed requests; it does
# not replace the scoped internal AI API above. Generate a unique 32+ byte
# random value and store it only in Railway Variables and OmniDimension's
# encrypted header field, never in source control.
OMNIDIM_GATEWAY_ENABLED=false
OMNIDIM_GATEWAY_SECRET=
OMNIDIM_GATEWAY_RATE_LIMIT_PER_MINUTE=60

# Keep false unless a trusted reverse proxy overwrites and sanitizes
# X-Forwarded-For before it reaches the application.
OMNIDIM_GATEWAY_TRUST_PROXY_HEADERS=false

OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
AI_PATIENT_SESSION_TTL_SECONDS=900
SECURE_DOCUMENT_EXPIRY_MINUTES=10
APPLICATION_BASE_URL=https://clinic.example.com

# Provider-neutral notification configuration; never commit real credentials.
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# disabled in production until a reviewed provider adapter is configured.
# "test" is accepted only while the Flask app is running in TESTING mode.
AI_NOTIFICATION_MODE=disabled
